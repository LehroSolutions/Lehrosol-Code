# EditorConfig — https://editorconfig.org
# Matches the existing code in this repo: 2-space indent, LF, trailing newline.
# Keep this file in sync with .gitattributes (both must agree on LF).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
