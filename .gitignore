# LehroSol Code — ignore rules
# The app itself ships only electron/**, renderer/**, and package.json
# (see build.files in package.json), so this file covers local dev state,
# build output, and machine-specific scratch only.

# Dependencies
node_modules/

# Build output (electron-builder: installers, unpacked app, metadata)
dist/
build/*
!build/icon.ico
*.exe
*.blockmap
builder-debug.yml
latest.yml

# Local LehroSol data home (CLI state: vault, serve.json, engrams)
.lehro/

# Local model weights (GGUF) — large binaries, never commit
*.gguf

# Agent scratch dirs
.worktrees/

# Browser-automation artifacts
.playwright-mcp/

# Local env & secrets
.env
.env.*
!.env.example
.env.local

# Logs & OS junk
*.log
.DS_Store
Thumbs.db
