# pnpm settings for Electron + electron-builder
# Hoisted layout: electron-builder cannot follow pnpm's default symlinked
# node_modules when packaging, so use a flat npm-style tree.
node-linker=hoisted
# Note: build-script approval (onlyBuiltDependencies) lives in
# pnpm-workspace.yaml — pnpm 11 no longer reads the "pnpm" field in package.json.
