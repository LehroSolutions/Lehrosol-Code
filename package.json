{
  "name": "lehrosol-code",
  "productName": "Lehrosol Code",
  "private": true,
  "version": "2.4.2",
  "description": "Lehrosol Code — the agentic engineering IDE for local models. The desktop front-end of LehroSol: model vault, agent missions, live system graph, and an editor with AI suggestions, all running against GGUFs on your own drive.",
  "license": "Apache-2.0",
  "author": "Lehro Solutions",
  "main": "electron/main.js",
  "packageManager": "pnpm@11.15.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LehroSolutions/Lehrosol-Code.git"
  },
  "homepage": "https://github.com/LehroSolutions/Lehrosol-Code#readme",
  "bugs": {
    "url": "https://github.com/LehroSolutions/Lehrosol-Code/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "check": "node scripts/check.mjs",
    "test": "node --test \"test-app/*.test.js\"",
    "smoke": "node scripts/smoke.cjs",
    "verify:installation": "powershell.exe -NoProfile -NonInteractive -File scripts/verify-installation.ps1",
    "dist": "electron-builder --win --x64 --publish=never",
    "release:prepare": "node scripts/release.mjs"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "playwright": "1.61.1"
  },
  "build": {
    "appId": "solutions.lehro.lehrosolcode",
    "productName": "Lehrosol Code",
    "files": [
      "electron/**",
      "renderer/**",
      "docs/**",
      "LICENSE",
      "NOTICE",
      "CHANGELOG.md",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Lehrosol.Code.Setup.${version}.exe",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "guid": "f487ccb7-2921-5fe7-8c43-cc99c9874470",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    }
  }
}
