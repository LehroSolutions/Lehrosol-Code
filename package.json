{
  "name": "lehrosol-code",
  "productName": "Lehrosol Code",
  "private": true,
  "version": "2.4.1",
  "description": "Lehrosol Code — the agentic engineering IDE for local models. The desktop front-end of LehroSol: model vault, agent missions, live system graph, and an editor with AI suggestions, all running against GGUFs on your own drive.",
  "license": "Apache-2.0",
  "author": "Lehro Solutions",
  "main": "electron/main.js",
  "packageManager": "pnpm@11.15.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LehroSolutions/Lehrosol-Code.git"
  },
  "homepage": "https://github.com/LehroSolutions/Lehrosol-Code#readme",
  "bugs": {
    "url": "https://github.com/LehroSolutions/Lehrosol-Code/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test \"test-app/*.test.js\"",
    "dist": "electron-builder --win --publish=never"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "solutions.lehro.lehrosolcode",
    "productName": "Lehrosol Code",
    "files": [
      "electron/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  }
}
